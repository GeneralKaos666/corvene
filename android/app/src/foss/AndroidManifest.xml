<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- "All files access": open a repository on shared storage in place
         instead of importing a copy. Asked for only when the user chooses
         to; Google Play does not allow it for this kind of application, so
         the play flavour does without. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
</manifest>
