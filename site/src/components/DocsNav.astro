---
import { DOC_ITEMS, CATEGORIES, docHref } from "../data/docs";

interface Props {
  currentSlug: string;
}
const { currentSlug } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div class="space-y-6">
  {
    CATEGORIES.map((category) => {
      const items = DOC_ITEMS.filter((item) => item.category === category);
      if (items.length === 0) return null;
      return (
        <div>
          <div class="eyebrow mb-2 px-2.5 text-[11px] text-fg-subtle">{category}</div>
          <ul class="space-y-0.5">
            {items.map((item) => {
              const active = item.slug === currentSlug;
              return (
                <li>
                  <a
                    href={docHref(base, item.slug)}
                    aria-current={active ? "page" : undefined}
                    class={`block rounded-md border-l-2 px-2.5 py-1.5 text-sm transition-colors ${
                      active
                        ? "border-success-hover bg-success-emphasis/15 font-semibold text-success"
                        : "border-transparent text-fg-muted hover:bg-canvas-overlay hover:text-fg"
                    }`}
                  >
                    {item.title}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      );
    })
  }
</div>
