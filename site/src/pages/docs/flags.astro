---
import DocsLayout from "../../layouts/DocsLayout.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import { REPO_URL } from "../../lib/github";
import { flagCount } from "../../lib/version";

const count = flagCount();

const presets = [
  ["GitHub Desktop", "github-desktop", "Everything off. Behaves exactly like 3.6.6, bugs included."],
  ["Familiar", "familiar", "Looks like GitHub Desktop, keeps the fixes and improvements you can't see."],
  ["Corvene", "corvene", "The default. Most changes on."],
  ["Max", "max", "Corvene plus extras most people want, like tree-sitter highlighting."],
];

const examples = [
  ["202-fs-watcher", "Refresh when files change, not only when the window gets focus.", "on"],
  ["201-commit-templates", "Fill the commit description from the repository's commit.template.", "on"],
  ["206-import-from-github-desktop", "File › Import Repositories from GitHub Desktop.", "on"],
  ["101-high-contrast-theme", "A High Contrast theme.", "on"],
  ["105-tree-sitter-highlighting", "Highlight languages GitHub Desktop leaves plain.", "off"],
];
---

<DocsLayout
  currentSlug="flags"
  title="Flags"
  description="Switch Corvene's changes on and off, one by one or with a preset."
>
  <p>
    Nearly everything Corvene does differently from GitHub Desktop is a flag you can turn off: new features, bug fixes, small
    tweaks.{count ? ` There are ${count} of them.` : ""} Each has a number and a name, like <code>202-fs-watcher</code>. "On" always means
    Corvene's behaviour.
  </p>

  <h2 id="dialog">Flags dialog</h2>
  <p>
    Corvene › Flags (<kbd>⇧⌘,</kbd>), or File › Flags on Windows and Linux. Each flag says what it does, what GitHub
    Desktop does instead, and links the GitHub Desktop issues it's about. Bug fixes are hidden until you tick Show bug
    fixes. <code>x-corvene://flags?q=watcher</code> opens the dialog with a search filled in.
  </p>

  <h2 id="presets">Presets</h2>
  <p>A preset sets every flag at once. Anything you change by hand goes on top of it.</p>
  <table>
    <thead>
      <tr><th>Preset</th><th></th><th></th></tr>
    </thead>
    <tbody>
      {presets.map(([name, slug, text]) => (
        <tr>
          <td><strong>{name}</strong></td>
          <td><code>{slug}</code></td>
          <td>{text}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2 id="env">For one session</h2>
  <p>
    <code>CORVENE_FLAGS</code> sets flags for one run without saving anything. Separate entries with commas. A key can be
    the full name, just the number or just the slug, and a key with no value means on.
  </p>
  <CodeBlock code='CORVENE_FLAGS="preset=familiar,105-tree-sitter-highlighting=on" corvene' />

  <h2 id="examples">Some examples</h2>
  <table>
    <thead>
      <tr><th>Flag</th><th>Does</th><th>Default</th></tr>
    </thead>
    <tbody>
      {examples.map(([flag, text, value]) => (
        <tr>
          <td><code>{flag}</code></td>
          <td>{text}</td>
          <td>{value}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <p>
    The full list is in the dialog and in
    <a href={`${REPO_URL}/blob/main/crates/corvene-core/src/flags/registry.rs`} target="_blank" rel="noopener noreferrer">registry.rs</a>.
  </p>
</DocsLayout>
