---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroDownload from "../components/HeroDownload";
import BenchmarkComparison from "../components/BenchmarkComparison";
import DownloadsTable from "../components/DownloadsTable";
import DownloadPicker from "../components/DownloadPicker";
import { workspaceVersion } from "../lib/version";
import { BENCHMARK_METRICS, formatMetric } from "../data/benchmarks";
import { FAQS, faqLd, softwareApplicationLd, type SiteContext } from "../lib/seo";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const version = workspaceVersion();

const root = new URL(base, Astro.site).toString().replace(/\/$/, "");
const ctx: SiteContext = { root, page: `${root}/` };
const screenshot = `${root}/app-screenshot.webp`;
const jsonLd = [softwareApplicationLd(ctx, version, screenshot), faqLd(FAQS)];

const stat = (id: string) => {
  const metric = BENCHMARK_METRICS.find((m) => m.id === id);
  return metric ? formatMetric(metric.corvene, metric.unit) : "";
};
const stats = [
  { value: stat("cold-start"), label: "Launch to window", note: "GitHub Desktop: 2.5 s", color: "text-success" },
  { value: stat("memory-rss"), label: "Idle memory", note: "GitHub Desktop: 175 MB", color: "text-accent" },
  { value: stat("diff-open"), label: "Open a 5,000-line diff", note: "50,000-file repository", color: "text-done" },
  { value: stat("binary-size"), label: "Installed size", note: "GitHub Desktop: 681 MB", color: "text-attention-bright" },
];

const features = [
  {
    title: "The workflow you already know",
    text: "Changes, History, branches, every dialog and shortcut, just like GitHub Desktop 3.6.6. A test harness compares the two screenshot by screenshot.",
    color: "text-success bg-success-emphasis/15 border-success-emphasis/40",
    icon: "M8 16A8 8 0 1 1 8 0a8 8 0 0 1 0 16Zm3.78-9.72a.751.751 0 0 0-.018-1.042.751.751 0 0 0-1.042-.018L6.75 9.19 5.28 7.72a.751.751 0 0 0-1.042.018.751.751 0 0 0-.018 1.042l2 2a.75.75 0 0 0 1.06 0Z",
  },
  {
    title: "Rendered on the GPU",
    text: "Drawn with GPUI, the framework the Zed editor uses. No Chromium, so long diffs stay fast.",
    color: "text-accent bg-accent-emphasis/15 border-accent-emphasis/40",
    icon: "M9.504.43a1.516 1.516 0 0 1 2.437 1.713L10.415 5.5h2.123c1.57 0 2.346 1.909 1.22 3.004l-7.34 7.142a1.249 1.249 0 0 1-.871.354h-.302a1.25 1.25 0 0 1-1.157-1.723L5.633 10.5H3.462c-1.57 0-2.346-1.909-1.22-3.004L9.503.429Z",
  },
  {
    title: "gitoxide reads, git writes",
    text: "Reading the repository happens in process with gitoxide. Commits, checkouts and pushes run your own git, so hooks, credential helpers and config work as before.",
    color: "text-done bg-done-emphasis/15 border-done-emphasis/40",
    icon: "M9.5 3.25a2.25 2.25 0 1 1 3 2.122V6A2.5 2.5 0 0 1 10 8.5H6a1 1 0 0 0-1 1v1.128a2.251 2.251 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.5 0v1.836A2.493 2.493 0 0 1 6 7h4a1 1 0 0 0 1-1v-.628A2.25 2.25 0 0 1 9.5 3.25Zm-6 0a.75.75 0 1 0 1.5 0 .75.75 0 0 0-1.5 0Zm8.25-.75a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5ZM4.25 12a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Z",
  },
  {
    title: "Syntax highlighting for 300+ languages",
    text: "GitHub Desktop's highlighting out of the box. Turn on tree-sitter for everything else; the grammars download, or come built into the Full edition.",
    color: "text-attention-bright bg-attention/15 border-attention/40",
    icon: "M4.72 3.22a.75.75 0 0 1 1.06 1.06L2.06 8l3.72 3.72a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215L.47 8.53a.75.75 0 0 1 0-1.06Zm6.56 0a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042L13.94 8l-3.72 3.72a.749.749 0 0 1-1.275-.326.749.749 0 0 1 .215-.734L12.94 8 9.22 4.28a.75.75 0 0 1 0-1.06Z",
  },
  {
    title: "macOS, Windows, Linux, Android",
    text: "Homebrew, .dmg, an installer, .msi, .deb, .rpm, AppImage, Flatpak, snap and APKs.",
    color: "text-accent-muted bg-accent-emphasis/15 border-accent-emphasis/40",
    icon: "M14.25 1c.966 0 1.75.784 1.75 1.75v7.5A1.75 1.75 0 0 1 14.25 12h-3.727c.099 1.041.52 1.872 1.292 2.757A.752.752 0 0 1 11.25 16h-6.5a.75.75 0 0 1-.565-1.243c.772-.885 1.192-1.716 1.292-2.757H1.75A1.75 1.75 0 0 1 0 10.25v-7.5C0 1.784.784 1 1.75 1ZM1.75 2.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25ZM9.018 12H6.982a5.72 5.72 0 0 1-.765 2.5h3.566a5.72 5.72 0 0 1-.765-2.5Z",
  },
  {
    title: "No telemetry",
    text: "Nothing is reported anywhere. Your code, tokens and actions stay on your machine. MIT licensed, with every deviation from GitHub Desktop behind a flag you can switch off.",
    color: "text-danger bg-danger/15 border-danger/40",
    icon: "M4 4a4 4 0 0 1 8 0v2h.25c.966 0 1.75.784 1.75 1.75v5.5A1.75 1.75 0 0 1 12.25 15h-8.5A1.75 1.75 0 0 1 2 13.25v-5.5C2 6.784 2.784 6 3.75 6H4Zm8.25 3.5h-8.5a.25.25 0 0 0-.25.25v5.5c0 .138.112.25.25.25h8.5a.25.25 0 0 0 .25-.25v-5.5a.25.25 0 0 0-.25-.25ZM10.5 6V4a2.5 2.5 0 1 0-5 0v2Z",
  },
];
---

<BaseLayout
  title="Corvene: a native GitHub Desktop clone in Rust, for macOS, Windows, Linux and Android"
  jsonLd={jsonLd}
>
  <section id="download" class="hero-glow-bg relative overflow-hidden border-b border-edge/50 pb-16 pt-16 sm:pb-20 sm:pt-24">
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <HeroDownload client:load fallbackVersion={version} base={base} />

      <figure class="mx-auto mt-16 max-w-5xl">
        <div class="overflow-hidden rounded-xl border border-edge bg-canvas shadow-2xl shadow-black/80">
          <img
            src={`${base}/app-screenshot.webp`}
            alt="Corvene showing a repository's changed files and the diff of one file in the dark theme"
            width="2734"
            height="1581"
            class="block h-auto w-full select-none"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption class="mt-4 text-center text-xs text-fg-muted">Corvene on macOS in the dark theme, rendered by the app itself.</figcaption>
      </figure>
    </div>
  </section>

  <section aria-label="Key numbers" class="border-b border-edge/50 bg-canvas-inset py-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <dl class="grid grid-cols-2 gap-4 sm:gap-6 md:grid-cols-4">
        {
          stats.map((s) => (
            <div class="card space-y-1 p-6 text-center">
              <dd class={`whitespace-nowrap font-mono text-2xl font-extrabold tabular-nums sm:text-3xl lg:text-4xl ${s.color}`}>{s.value}</dd>
              <dt class="text-xs font-semibold text-fg">{s.label}</dt>
              <dd class="text-[11px] text-fg-muted">{s.note}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-5 text-center text-xs text-fg-subtle">
        On an M2 MacBook Air, against GitHub Desktop 3.6.6 and GitKraken 12.6. <a href={`${base}/docs/benchmarks`} class="text-fg-muted hover:text-fg hover:underline">How</a>
      </p>
    </div>
  </section>

  <section id="features" class="scroll-mt-16 border-b border-edge/50 bg-canvas py-20">
    <div class="mx-auto max-w-7xl space-y-12 px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl space-y-3 text-center">
        <h2 class="eyebrow text-success">What's inside</h2>
        <p class="font-display text-3xl font-bold text-fg sm:text-4xl">GitHub Desktop's workflow, without Electron</p>
        <p class="text-sm text-fg-muted sm:text-base">Same layout, buttons, menus and dialogs. A different engine underneath.</p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          features.map((f) => (
            <article class="card space-y-3 rounded-2xl p-7 transition-colors hover:border-edge-hover">
              <div class={`flex h-9 w-9 items-center justify-center rounded-lg border ${f.color}`}>
                <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <path d={f.icon} />
                </svg>
              </div>
              <h3 class="text-base font-bold text-fg">{f.title}</h3>
              <p class="text-sm leading-relaxed text-fg-muted">{f.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="benchmarks" class="scroll-mt-16 border-b border-edge/50 bg-canvas-inset py-20">
    <div class="mx-auto max-w-7xl space-y-10 px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl space-y-3 text-center">
        <h2 class="eyebrow text-accent">Speed and memory</h2>
        <p class="font-display text-3xl font-bold text-fg sm:text-4xl">Side by side</p>
        <p class="text-sm text-fg-muted sm:text-base">
          Corvene, GitHub Desktop 3.6.6 and GitKraken 12.6 on the same Mac, taking turns.
        </p>
      </div>

      <BenchmarkComparison client:visible />
    </div>
  </section>

  <section id="downloads" class="scroll-mt-16 border-b border-edge/50 bg-canvas py-20">
    <div class="mx-auto max-w-7xl space-y-10 px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl space-y-3 text-center">
        <h2 class="eyebrow text-accent">Downloads</h2>
        <p class="font-display text-3xl font-bold text-fg sm:text-4xl">Every platform, every format</p>
        <p class="text-sm text-fg-muted sm:text-base">Direct links into the latest GitHub release. Pick the Standard edition unless you want every syntax grammar offline.</p>
        <div class="pt-3">
          <DownloadPicker client:idle fallbackVersion={version} />
        </div>
      </div>

      <DownloadsTable client:visible fallbackVersion={version} />
    </div>
  </section>

  <section id="faq" class="scroll-mt-16 border-b border-edge/50 bg-canvas-inset py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl space-y-3 text-center">
        <h2 class="eyebrow text-done">Questions</h2>
        <p class="font-display text-3xl font-bold text-fg sm:text-4xl">Frequently asked</p>
      </div>
      <dl class="mt-10 divide-y divide-edge-muted overflow-hidden rounded-2xl border border-edge bg-canvas">
        {
          FAQS.map((faq) => (
            <details class="faq-item group transition-colors duration-300 data-[state=open]:bg-canvas-subtle/40" data-state="closed">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-4 text-left text-sm font-semibold text-fg hover:text-accent [&::-webkit-details-marker]:hidden">
                <dt>{faq.question}</dt>
                <svg class="h-4 w-4 shrink-0 text-fg-muted transition-transform duration-300 ease-out group-data-[state=open]:rotate-180 group-data-[state=open]:text-accent" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <path d="M12.78 5.22a.749.749 0 0 1 0 1.06l-4.25 4.25a.749.749 0 0 1-1.06 0L3.22 6.28a.749.749 0 1 1 1.06-1.06L8 8.939l3.72-3.719a.749.749 0 0 1 1.06 0Z" />
                </svg>
              </summary>
              <dd class="faq-body px-6 pb-5 text-sm leading-relaxed text-fg-muted">{faq.answer}</dd>
            </details>
          ))
        }
      </dl>
    </div>
  </section>

  <script>
    // Ease the FAQ answers open and shut. <details> jumps between its two
    // heights, so the click animates the element's height (and the answer's
    // fade) with the Web Animations API, from wherever a running animation
    // left it. data-state flips at the start, so the chevron and background
    // turn with the motion rather than after it.
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const EASING = "cubic-bezier(0.2, 0.8, 0.2, 1)";

    for (const details of document.querySelectorAll<HTMLDetailsElement>("details.faq-item")) {
      const summary = details.querySelector("summary");
      const body = details.querySelector<HTMLElement>(".faq-body");
      if (!summary || !body) continue;
      let height: Animation | null = null;
      let fade: Animation | null = null;
      let closing = false;

      // keyboard, find-in-page and reduced motion still toggle natively
      details.addEventListener("toggle", () => {
        if (!closing) details.dataset.state = details.open ? "open" : "closed";
      });

      const settle = () => {
        height = fade = null;
        closing = false;
        details.style.overflow = "";
      };

      // `from` is measured before the content shows; the animation starts in
      // the same task, so the full height never paints
      const run = (open: boolean, from: number) => {
        const style = getComputedStyle(details);
        const border = (parseFloat(style.borderTopWidth) || 0) + (parseFloat(style.borderBottomWidth) || 0);
        // fractional heights: offsetHeight rounds, and the last frame would jump a pixel
        const to = border + summary.getBoundingClientRect().height + (open ? body.getBoundingClientRect().height : 0);
        height?.cancel();
        fade?.cancel();
        closing = !open;
        details.dataset.state = open ? "open" : "closed";
        details.style.overflow = "hidden";
        const duration = Math.min(380, 180 + Math.abs(to - from) * 0.6);
        height = details.animate({ height: [`${from}px`, `${to}px`] }, { duration, easing: EASING });
        fade = body.animate(
          open
            ? { opacity: [0, 1], transform: ["translateY(-6px)", "none"] }
            : { opacity: [1, 0], transform: ["none", "translateY(-6px)"] },
          { duration: duration * (open ? 1 : 0.7), easing: EASING, fill: "both" }
        );
        height.onfinish = () => {
          if (!open) details.open = false;
          fade?.cancel();
          settle();
        };
      };

      summary.addEventListener("click", (event) => {
        if (reduceMotion.matches) return;
        event.preventDefault();
        const from = details.getBoundingClientRect().height;
        if (closing || !details.open) {
          details.open = true;
          run(true, from);
        } else {
          run(false, from);
        }
      });
    }
  </script>

  <section class="bg-canvas py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="space-y-6 rounded-2xl border border-edge bg-gradient-to-r from-canvas-subtle via-canvas to-canvas-subtle p-8 text-center shadow-xl sm:p-12">
        <h2 class="text-2xl font-bold text-fg sm:text-3xl">Keep the workflow. Lose the overhead.</h2>
        <p class="mx-auto max-w-xl text-sm text-fg-muted sm:text-base">
          Install the latest release, or read how it is built.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
          <a href="#download" class="btn-hero px-6 py-2.5 text-sm">Download Corvene</a>
          <a href={`${base}/docs/`} class="btn-default px-6 py-2.5">Read the docs</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
