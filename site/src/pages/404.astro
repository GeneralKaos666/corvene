---
import BaseLayout from "../layouts/BaseLayout.astro";
import { DOC_ITEMS, docHref } from "../data/docs";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title="Page not found · Corvene" description="That page does not exist on the Corvene site." noindex>
  <section class="mx-auto flex min-h-[60vh] max-w-2xl flex-col items-center justify-center px-4 py-24 text-center sm:px-6">
    <p class="eyebrow text-fg-muted">404</p>
    <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-fg sm:text-5xl">Nothing here</h1>
    <p class="mt-4 text-base text-fg-muted">
      The page moved or never existed. The downloads and the documentation are a click away.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href={`${base}/`} class="btn-primary">Home</a>
      <a href={`${base}/#downloads`} class="btn-default">Downloads</a>
      <a href={`${base}/docs/`} class="btn-default">Docs</a>
    </div>
    <nav aria-label="Documentation" class="mt-12 w-full text-left">
      <h2 class="eyebrow mb-3 text-fg-subtle">Documentation</h2>
      <ul class="grid gap-2 sm:grid-cols-2">
        {
          DOC_ITEMS.map((item) => (
            <li>
              <a href={docHref(base, item.slug)} class="card block p-3 text-sm transition-colors hover:border-edge-hover hover:bg-canvas-subtle">
                <span class="font-semibold text-fg">{item.title}</span>
                <span class="mt-0.5 block text-xs text-fg-muted">{item.description}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </section>
</BaseLayout>
