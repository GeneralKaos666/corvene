{
  "name": "Corvene",
  "short_name": "Corvene",
  "description": "A native GitHub Desktop clone in Rust: downloads and documentation.",
  "start_url": "/corvene/",
  "scope": "/corvene/",
  "display": "browser",
  "background_color": "#0d1117",
  "theme_color": "#0d1117",
  "icons": [
    { "src": "/corvene/icon/Corvene-256.png", "sizes": "256x256", "type": "image/png" },
    { "src": "/corvene/icon/Corvene-1024.png", "sizes": "1024x1024", "type": "image/png" },
    { "src": "/corvene/icon/Corvene.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
