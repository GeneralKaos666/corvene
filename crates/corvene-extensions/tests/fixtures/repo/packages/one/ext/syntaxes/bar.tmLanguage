<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>Bar</string>
	<key>scopeName</key>
	<string>source.bar</string>
	<key>fileTypes</key>
	<array><string>bar</string></array>
	<key>patterns</key>
	<array>
		<dict>
			<key>match</key>
			<string>\b(let|fn)\b</string>
			<key>name</key>
			<string>keyword.other.bar</string>
		</dict>
		<dict>
			<key>match</key>
			<string>(?&lt;=a+)b</string>
			<key>name</key>
			<string>invalid.illegal.bar</string>
		</dict>
	</array>
</dict>
</plist>
