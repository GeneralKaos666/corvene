#!/bin/sh
# Corvene's AppImage entry point. Run through a link named `corvene` (Help ›
# Install command line tool… links ~/.local/bin/corvene to the AppImage),
# it is the command line tool (`corvene`, `corvene open <path>`,
# `corvene clone <url>`); run as the AppImage itself, it starts the app
# with its arguments (the x-corvene:// URLs a desktop entry passes).
HERE="$(dirname "$(readlink -f "$0")")"
APP="$HERE/usr/lib/corvene/corvene"
case "$(basename "${ARGV0:-$0}")" in
  corvene)
    # the tool starts Corvene in the background and exits, which unmounts
    # this image: it runs the AppImage again, which stays mounted
    CORVENE_BIN="${APPIMAGE:-$APP}" exec "$HERE/usr/lib/corvene/bin/corvene" "$@"
    ;;
  *)
    exec "$APP" "$@"
    ;;
esac
