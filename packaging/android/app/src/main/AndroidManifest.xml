<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- clone, fetch, push, the GitHub API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- pull request notifications; asked for at run time on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- CorvaneTransferService: a clone, fetch or push goes on after the
         user leaves the application -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- "Open in Termux": Termux's RUN_COMMAND intent -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <queries>
        <package android:name="com.termux" />
        <!-- the editors Options › Integrations lists -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="text/*" />
        </intent>
    </queries>

    <!-- wgpu draws with Vulkan and falls back to OpenGL ES 3 -->
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:required="false"
        android:version="0" />
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <!-- tablets, Chromebooks and DeX: none of these is needed to run -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/CorvaneTheme">

        <!--
          A NativeActivity: it loads libcorvane.so (`android.app.lib_name`)
          and android-activity runs the app's `android_main` in it. The
          configuration changes listed do not recreate the activity; GPUI
          resizes and re-themes the window instead.
        -->
        <activity
            android:name=".CorvaneActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|touchscreen|locale|layoutDirection|colorMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="android.app.lib_name"
                android:value="corvane" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- x-corvane://openRepo/… links and the browser sign-in's
                 x-corvane-auth://oauth callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="x-corvane" />
                <data android:scheme="x-corvane-auth" />
            </intent-filter>

            <!-- A repository's address shared from a browser or another
                 application: the Clone dialog opens with it. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".CorvaneTransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The clones live in app-private storage; this shows them to
             editors and file managers through the system's file picker. -->
        <provider
            android:name=".CorvaneDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
